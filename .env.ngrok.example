## Ngrok / prod-like HTTPS profile (forces https for testing)
APP_ENV=production
APP_DEBUG=false

# Toggle target: comment/uncomment to flip quickly between ngrok HTTPS and local HTTP when testing.
APP_URL=https://example-subdomain.ngrok-free.app
# APP_URL=http://localhost:8000  # uncomment for local HTTP without editing other lines
TRUSTED_PROXIES=*

# HTTPS toggles (safe behind proxies)
FORCE_HTTPS=true
FORCE_ROUTE_HTTPS=true  # redirect to https; remove/disable in real prod if not needed

# TEMP: replace ngrok URL with real domain and drop the localhost fallback line when deploying to production.

# DB/mail/etc copied from your base .env as needed
