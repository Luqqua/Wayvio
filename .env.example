APP_NAME=Wayvio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
TRUSTED_PROXIES=

# Legal agreement snapshot configuration
LEGAL_AGB_VERSION=v2.1
LEGAL_AVV_VERSION=v1.9
LEGAL_PRIVACY_VERSION=v1.8
LEGAL_IMPRINT_VERSION=2026-05
LEGAL_AGB_TEXT_FILE=../legal_docs/wayvio_agb.txt
LEGAL_AVV_TEXT_FILE=../legal_docs/wayvio_avv.txt
LEGAL_PRIVACY_TEXT_FILE=../legal_docs/wayvio_datenschutz.txt
LEGAL_IMPRINT_TEXT_FILE=../legal_docs/wayvio_impressum.txt
LEGAL_AGB_TEXT_FILE_EN=../legal_docs/wayvio_agb_en.txt
LEGAL_AVV_TEXT_FILE_EN=../legal_docs/wayvio_avv_en.txt
LEGAL_PRIVACY_TEXT_FILE_EN=../legal_docs/wayvio_datenschutz_en.txt
LEGAL_IMPRINT_TEXT_FILE_EN=../legal_docs/wayvio_impressum_en.txt
LEGAL_AGB_SHA256=2fe217f2ebac04e6382b928d1aeb0c48b98c274fec30b63cfa0c494343d22abe
LEGAL_AVV_SHA256=7e2b7b4cb8ad395b37ec1003845f0d77c260f1bde6ee42ee6bfc1a3eaca00250
LEGAL_PRIVACY_SHA256=71f507d16cceb88b50e9f5154c1c25093968e032e4fa2682c5431abcad4f32d8
LEGAL_IMPRINT_SHA256=98bd6bd5314efa7ff32b77e9a80b5ff29da09f663f621f0ec966f5664e8b6e68
LEGAL_AGB_SHA256_EN=27c8109bef0ce40949ffedbbd2c4f271724f1046044d73fa0eaa1c9c94b1aeb1
LEGAL_AVV_SHA256_EN=db892e26b4be54a62bfebaa3593fa0d0aa5cdbd2f03db06a471687eb38dc016e
LEGAL_PRIVACY_SHA256_EN=336ddb94168a5eafdcc15565503b3c369913a17abf6efd2b532dc292ad5fea0f
LEGAL_IMPRINT_SHA256_EN=6a4de23e82d7d3cf3f7dcd5883c94084fb3fded86e7e5c379a9c0d2edc16238e
# DSGVO PFLICHT (§ 5 DDG / Art. 13 DSGVO): Betreiberstammdaten VOR Go-Live setzen.
# Diese Werte ersetzen die Platzhalter [VORNAME NACHNAME] / [STRASSE NR, PLZ ORT] /
# [EMAIL@DOMAIN.DE] in den Rechtstexten (Impressum, Datenschutzerklärung).
# Leer lassen = Platzhalter bleiben im veröffentlichten Text – ist ein DSGVO-Verstoß.
LEGAL_PROVIDER_NAME="[COMPANY OR OPERATOR NAME]"
LEGAL_PROVIDER_ADDRESS="[STREET NUMBER, POSTAL CODE CITY]"
LEGAL_PROVIDER_EMAIL=support@example.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# Production hardening (DB dump + TLS)
# Set to directory containing mysqldump (or full binary path).
# Example MAMP: /Applications/MAMP/Library/bin/mysql80/bin
# Example Linux: /usr/bin
DB_DUMP_BINARY_PATH=
DB_DUMP_TIMEOUT_SECONDS=300
DB_DUMP_USE_SINGLE_TRANSACTION=true
# In production, set true unless DB is strictly local via unix socket.
DB_REQUIRE_TLS=false
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_VERIFY_SERVER_CERT=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# DSGVO: In Produktion EU-Region setzen, z. B. eu-central-1 (Frankfurt).
# us-east-1 = USA-Drittlandtransfer; nur zulässig mit gültigem SCC/DPF.
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Media storage (S3-ready, default local)
MEDIA_DISK=media_local
MEDIA_TENANT_PREFIX=tenants
MEDIA_CONVERT_TO_WEBP=true
MEDIA_WEBP_QUALITY=82
MEDIA_UPLOAD_RATE_LIMIT_PER_MINUTE=10
MEDIA_RESPONSIVE_VARIANTS_ENABLED=false
MEDIA_RESPONSIVE_VARIANT_WIDTHS=256,512,1024
MEDIA_RESPONSIVE_VARIANT_QUALITY=80
MEDIA_RESPONSIVE_VARIANTS_QUEUE=media
MEDIA_MALWARE_SCAN_ENABLED=false
MEDIA_MALWARE_SCAN_FAIL_CLOSED=false
MEDIA_MALWARE_SCAN_BINARY=clamscan
MEDIA_MALWARE_SCAN_ARGS="--no-summary --infected"
MEDIA_MALWARE_SCAN_TIMEOUT_SECONDS=20
MEDIA_BACKUP_TARGET_DISK=backups
MEDIA_BACKUP_PREFIX=media-backups
MEDIA_AUTOMATED_BACKUP_ENABLED=false
# daily|weekly|monthly
MEDIA_AUTOMATED_BACKUP_INTERVAL=daily
MEDIA_AUTOMATED_BACKUP_TIME=03:15
MEDIA_ALERT_WEBHOOK_URL=
MEDIA_BACKUP_HEALTH_MAX_AGE_HOURS=30
MEDIA_RESTORE_DRILL_ENABLED=false
MEDIA_RESTORE_DRILL_DAY_OF_MONTH=1
MEDIA_RESTORE_DRILL_TIME=04:15
MEDIA_RESTORE_DRILL_SAMPLE_FILES=20
MEDIA_LOCAL_URL="${APP_URL}/assets/media"
MEDIA_AWS_ACCESS_KEY_ID=
MEDIA_AWS_SECRET_ACCESS_KEY=
MEDIA_AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION}"
MEDIA_AWS_BUCKET=
MEDIA_AWS_URL=
MEDIA_AWS_ENDPOINT=
MEDIA_AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_AWS_ROOT=

# Unified backup automation control (DB + media + full snapshots)
# Local filesystem path for the `backups` disk.
# Production recommendation: /var/backups/wayvio
# If omitted, Laravel falls back to <project>/backups.
BACKUPS_DISK_ROOT=
BACKUP_NAME=db-backups
BACKUP_TEMPORARY_DIRECTORY=
BACKUP_TARGET_PROFILE=local
BACKUP_DB_CONNECTION="${DB_CONNECTION}"
BACKUP_DB_DISK=backups
BACKUP_DB_AUTOMATED_ENABLED=false
# daily|weekly|monthly
BACKUP_DB_AUTOMATED_INTERVAL=daily
BACKUP_DB_AUTOMATED_TIME=02:30
BACKUP_FULL_AUTOMATED_ENABLED=false
# daily|weekly|monthly
BACKUP_FULL_AUTOMATED_INTERVAL=daily
BACKUP_FULL_AUTOMATED_TIME=03:30
BACKUP_FULL_DB_DISK="${BACKUP_DB_DISK}"
BACKUP_FULL_MEDIA_TARGET_DISK="${MEDIA_BACKUP_TARGET_DISK}"
BACKUP_FULL_MEDIA_PREFIX="${MEDIA_BACKUP_PREFIX}"
BACKUP_FULL_MANIFEST_DISK="${BACKUP_FULL_MEDIA_TARGET_DISK}"
BACKUP_FULL_PREFIX=full-backups
BACKUP_SCHEDULER_HEARTBEAT_PATH=
BACKUP_SCHEDULER_HEARTBEAT_STALE_MINUTES=5
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ARCHIVE_PASSWORD=
# default|aes-256|none
BACKUP_ARCHIVE_ENCRYPTION=default
# Policy controls (recommended true in production)
BACKUP_REQUIRE_ARCHIVE_PASSWORD=false
BACKUP_REQUIRE_ARCHIVE_ENCRYPTION=false
BACKUP_REQUIRE_DB_DUMP_BINARY_PATH=false
BACKUP_REQUIRE_OUTSIDE_PROJECT_ROOT=false
BACKUP_RETENTION_KEEP_ALL_DAYS=2
BACKUP_RETENTION_DAILY_DAYS=14
BACKUP_RETENTION_WEEKLY_WEEKS=8
BACKUP_RETENTION_MONTHLY_MONTHS=12
BACKUP_RETENTION_YEARLY_YEARS=2
BACKUP_RETENTION_MAX_MB=0

# Cloudflare R2 Backup Worker (workers/cloudflare_worker_r2_backup_standalone.js)
# Aktivierung: BACKUP_DB_DISK=backups_worker (und alle FULL-Disks unten)
WORKER_R2_URL=
WORKER_R2_AUTH_TOKEN=
WORKER_R2_SHARED_SECRET=
WORKER_R2_TIMEOUT=120

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Internal analytics microservice bridge
# DSGVO: ANALYTICS_PRIVACY_MODE=true (Standard) – IP wird nicht persistiert,
# nur Ländercode wird aus GeoIP extrahiert. Nicht auf false setzen ohne DPIA.
ANALYTICS_PRIVACY_MODE=true
ANALYTICS_API_BASE=http://127.0.0.1:8001
ANALYTICS_INTERNAL_API_KEY=
ANALYTICS_HTTP_TIMEOUT=2.5
ANALYTICS_LANDING_ENABLED=false
ANALYTICS_LANDING_SITE_ID=
ANALYTICS_LANDING_ACTOR_USER_ID=
ANALYTICS_LANDING_TIER_LEVEL=business

# Internal forms bridge
FORMS_ENABLED=true
FORMS_API_BASE=http://127.0.0.1:8001
FORMS_MS_INTERNAL_API_KEY=
FORMS_MAINTENANCE_SECRET=
FORMS_HTTP_TIMEOUT=5.0
FORMS_RETENTION_DAYS=180
FORMS_TURNSTILE_REQUIRED=true
FORMS_BOT_PROTECTION_PROVIDER=turnstile
FORMS_BOT_PROTECTION_REQUIRED=true
CAP_FORMS_BASE_URL=http://127.0.0.1:3030
CAP_FORMS_VERIFY_BASE_URL=http://127.0.0.1:3030
CAP_FORMS_SITE_KEY=
CAP_FORMS_SECRET=
CAP_FORMS_HTTP_TIMEOUT=5.0
FORMS_PLATFORM_HUB_USER_ID=
TURNSTILE_SITE_KEY_FORMS_IMPRINT_CONTACT=
TURNSTILE_SECRET_FORMS_IMPRINT_CONTACT=
TURNSTILE_SITE_KEY_FORMS_HUB_CONTACT_BLOCK=
TURNSTILE_SECRET_FORMS_HUB_CONTACT_BLOCK=

# Unified internal API bridge (analytics + billing + domains + forms)
INTERNAL_API_BASE_URL=http://127.0.0.1:8001
INTERNAL_API_KEY=
INTERNAL_API_TIMEOUT=2.0

# Billing internal API rollout
BILLING_MS_ENABLED=false
BILLING_MS_BASE_URL=http://127.0.0.1:8001
BILLING_MS_INTERNAL_API_KEY=
BILLING_ENABLED_PERIODS=1
BILLING_MS_TIMEOUT=2.0
BILLING_MS_CHECKOUT_TIMEOUT=10.0
BILLING_MS_PORTAL_TIMEOUT=10.0
BILLING_MS_CHANGE_TIMEOUT=20.0
BILLING_MS_DELETE_TIMEOUT=20.0
BILLING_MS_CONFIRM_TIMEOUT=10.0
BILLING_MS_WEBHOOK_TIMEOUT=15.0
BILLING_MS_STATE_TIMEOUT=5.0
BILLING_NOTIFICATION_EMAILS_ENABLED=true

# Partners internal API rollout
PARTNERS_MS_ENABLED=false
PARTNERS_MS_BASE_URL=http://127.0.0.1:8001
PARTNERS_MS_INTERNAL_API_KEY=
PARTNERS_MS_TIMEOUT=2.0
PARTNERS_MS_WEBHOOK_TIMEOUT=15.0
PARTNERS_MS_SETTLE_VERIFY_TIMEOUT=10.0
PARTNERS_ONBOARDING_DEFAULT_COUNTRY=DE
PARTNERS_ONBOARDING_ALLOWED_COUNTRIES=DE,AT
PARTNERS_MANUAL_ONLY=true
PARTNERS_AUTO_APPROVE_COMMISSIONS=false
PARTNERS_WEB_DASHBOARD_ENABLED=false
SHOW_PARTNER_CODE_FIELD_AT_REGISTRATION=no
PARTNERS_PAYOUT_SETTLE_REQUIRE_VERIFIED_TRANSFER=true

# Internal admin bridge (Node admin-management -> Laravel)
INTERNAL_ADMIN_ENABLED=false
INTERNAL_ADMIN_TOKEN=
INTERNAL_ADMIN_ALLOWED_IPS=127.0.0.1,::1
INTERNAL_ADMIN_REQUIRE_LOOPBACK=true
INTERNAL_ADMIN_RATE_LIMIT_PER_MINUTE=120

# Internal partner webhook bridge (Node internal-apis -> Laravel)
INTERNAL_PARTNER_WEBHOOK_ENABLED=false
INTERNAL_PARTNER_WEBHOOK_TOKEN=
INTERNAL_PARTNER_WEBHOOK_ALLOWED_IPS=127.0.0.1,::1
INTERNAL_PARTNER_WEBHOOK_REQUIRE_LOOPBACK=true
INTERNAL_PARTNER_WEBHOOK_RATE_LIMIT_PER_MINUTE=240

# Installer security guard (enable only in controlled setup environments)
INSTALLER_ENABLED=false
INSTALLER_ONE_TIME_SECRET=
INSTALLER_ALLOWED_IPS=127.0.0.1,::1
INSTALLER_REQUIRE_LOOPBACK=true
BILLING_NOTIFICATION_BATCH_SIZE=100
BILLING_NOTIFICATION_MAX_ATTEMPTS=5
BILLING_SUPPORT_EMAIL=

# Custom domains internal API rollout (Cloudflare for SaaS)
DOMAINS_MS_ENABLED=false
DOMAINS_MS_BASE_URL=http://127.0.0.1:8001
DOMAINS_MS_INTERNAL_API_KEY=
DOMAINS_MS_TIMEOUT=2.0
DOMAINS_MS_CREATE_TIMEOUT=15.0
DOMAINS_MS_DELETE_TIMEOUT=20.0
DOMAINS_MS_VERIFY_TIMEOUT=15.0
DOMAINS_MS_SYNC_TIMEOUT=15.0
DOMAINS_MS_CLEANUP_TIMEOUT=15.0
DOMAINS_MS_RECONCILE_TIMEOUT=20.0
CUSTOM_DOMAIN_PROVIDER=cloudflare
CUSTOM_DOMAIN_CNAME_TARGET=customers.wayvio.com
CUSTOM_DOMAIN_QUEUE=domains
CUSTOM_DOMAIN_JOB_MAX_ATTEMPTS=8
CUSTOM_DOMAIN_JOB_BACKOFF_SECONDS=60,300,900,1800,3600,7200
CUSTOM_DOMAIN_JOB_RETRY_WINDOW_HOURS=24
CUSTOM_DOMAIN_JOB_TIMEOUT_SECONDS=300

# Agency hub slot bounds + default allocation
AGENCY_MIN_HUBS=2
AGENCY_MAX_HUBS=15
AGENCY_HUB_SLOTS=2

# Compliance audit log retention (DSGVO Art. 5 Abs. 1 lit. e Speicherbegrenzung)
# Einträge älter als diese Anzahl Tage werden täglich gelöscht. 0 = deaktiviert (nicht empfohlen).
COMPLIANCE_AUDIT_LOG_RETENTION_DAYS=365
PRIVACY_SESSION_RETENTION_HOURS=26
PRIVACY_AUDIT_LOG_RETENTION_DAYS=365
PRIVACY_ADMIN_AUDIT_LOG_RETENTION_DAYS=365
PRIVACY_PARTNER_AUDIT_LOG_RETENTION_DAYS=365
PRIVACY_ACCOUNT_DELETION_AUDIT_LOG_RETENTION_DAYS=365
PRIVACY_BILLING_WEBHOOK_PAYLOAD_REDACTION_DAYS=90
PRIVACY_STRIPE_WEBHOOK_PAYLOAD_REDACTION_DAYS=90
PRIVACY_PARTNER_WEBHOOK_PAYLOAD_REDACTION_DAYS=90
PRIVACY_BILLING_WEBHOOK_RETENTION_DAYS=730
PRIVACY_STRIPE_WEBHOOK_LOG_RETENTION_DAYS=730
PRIVACY_PARTNER_WEBHOOK_RETENTION_DAYS=730
PRIVACY_BILLING_NOTIFICATION_OUTBOX_RETENTION_DAYS=365
PRIVACY_ADMIN_LOGIN_ATTEMPT_RETENTION_HOURS=24

# Reports security and retention
REPORT_RATE_LIMIT_PER_MINUTE=5
REPORT_RATE_LIMIT_PER_DAY=60
REPORT_TARGET_RATE_LIMIT_PER_HOUR=3
REPORT_ALLOW_SELF_REPORT=false
REPORT_CAPTCHA_REQUIRED=false
TURNSTILE_SITE_KEY_REPORT=
TURNSTILE_SECRET_REPORT=
REPORT_RETENTION_DAYS=180
