# Wayvio production template
# Copy to .env and replace all REPLACE_* values before go-live.

APP_NAME=Wayvio
APP_ENV=production
APP_KEY=REPLACE_WITH_BASE64_APP_KEY
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_PROD_DOMAIN
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=wayvio
DB_USERNAME=wayvio_prod
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Stable dump execution for backups
DB_DUMP_BINARY_PATH=/usr/bin
DB_DUMP_TIMEOUT_SECONDS=300
DB_DUMP_USE_SINGLE_TRANSACTION=true

# TLS between app and DB (required for non-socket production links)
DB_REQUIRE_TLS=true
DB_SSL_CA=/etc/ssl/certs/REPLACE_DB_CA_FILE.pem
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_VERIFY_SERVER_CERT=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@REPLACE_WITH_PROD_DOMAIN
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=

# Media storage baseline (local on app host)
MEDIA_DISK=media_local
MEDIA_TENANT_PREFIX=tenants
MEDIA_CONVERT_TO_WEBP=true
MEDIA_WEBP_QUALITY=82
MEDIA_UPLOAD_RATE_LIMIT_PER_MINUTE=10
MEDIA_RESPONSIVE_VARIANTS_ENABLED=false
MEDIA_RESPONSIVE_VARIANT_WIDTHS=256,512,1024
MEDIA_RESPONSIVE_VARIANT_QUALITY=80
MEDIA_RESPONSIVE_VARIANTS_QUEUE=media
MEDIA_MALWARE_SCAN_ENABLED=false
MEDIA_MALWARE_SCAN_FAIL_CLOSED=false
MEDIA_MALWARE_SCAN_BINARY=clamscan
MEDIA_MALWARE_SCAN_ARGS="--no-summary --infected"
MEDIA_MALWARE_SCAN_TIMEOUT_SECONDS=20
MEDIA_LOCAL_URL="${APP_URL}/assets/media"

# Optional media S3 (fill only if MEDIA_DISK=media_s3)
MEDIA_AWS_ACCESS_KEY_ID=
MEDIA_AWS_SECRET_ACCESS_KEY=
MEDIA_AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION}"
MEDIA_AWS_BUCKET=
MEDIA_AWS_URL=
MEDIA_AWS_ENDPOINT=
MEDIA_AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_AWS_ROOT=

# Reports security and retention
REPORT_RATE_LIMIT_PER_MINUTE=5
REPORT_RATE_LIMIT_PER_DAY=60
REPORT_TARGET_RATE_LIMIT_PER_HOUR=3
REPORT_ALLOW_SELF_REPORT=false
REPORT_CAPTCHA_REQUIRED=true
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY_REPORT=REPLACE_WITH_REPORT_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_REPORT=REPLACE_WITH_REPORT_TURNSTILE_SECRET
REPORT_RETENTION_DAYS=180

# Backup target
BACKUPS_DISK_ROOT=/var/backups/wayvio
BACKUP_TARGET_PROFILE=local
BACKUP_DB_CONNECTION="${DB_CONNECTION}"
BACKUP_DB_DISK=backups
MEDIA_BACKUP_TARGET_DISK=backups
MEDIA_BACKUP_PREFIX=media-backups
BACKUP_FULL_DB_DISK=backups
BACKUP_FULL_MEDIA_TARGET_DISK=backups
BACKUP_FULL_MEDIA_PREFIX="${MEDIA_BACKUP_PREFIX}"
BACKUP_FULL_MANIFEST_DISK=backups
BACKUP_FULL_PREFIX=full-backups

# Encryption at backup archive level
BACKUP_ARCHIVE_PASSWORD=REPLACE_WITH_LONG_RANDOM_BACKUP_SECRET
BACKUP_ARCHIVE_ENCRYPTION=default

# Hard security policy checks
BACKUP_REQUIRE_ARCHIVE_PASSWORD=true
BACKUP_REQUIRE_ARCHIVE_ENCRYPTION=true
BACKUP_REQUIRE_DB_DUMP_BINARY_PATH=true
BACKUP_REQUIRE_OUTSIDE_PROJECT_ROOT=true

# Automated schedules
BACKUP_DB_AUTOMATED_ENABLED=true
BACKUP_DB_AUTOMATED_INTERVAL=daily
BACKUP_DB_AUTOMATED_TIME=01:05
MEDIA_AUTOMATED_BACKUP_ENABLED=true
MEDIA_AUTOMATED_BACKUP_INTERVAL=weekly
MEDIA_AUTOMATED_BACKUP_TIME=02:10
BACKUP_FULL_AUTOMATED_ENABLED=true
BACKUP_FULL_AUTOMATED_INTERVAL=monthly
BACKUP_FULL_AUTOMATED_TIME=03:15

# Health + alerting + retention
BACKUP_SCHEDULER_HEARTBEAT_PATH=
BACKUP_SCHEDULER_HEARTBEAT_STALE_MINUTES=5
BACKUP_ALERT_WEBHOOK_URL=
MEDIA_ALERT_WEBHOOK_URL=
MEDIA_BACKUP_HEALTH_MAX_AGE_HOURS=30
MEDIA_RESTORE_DRILL_ENABLED=true
MEDIA_RESTORE_DRILL_DAY_OF_MONTH=1
MEDIA_RESTORE_DRILL_TIME=04:15
MEDIA_RESTORE_DRILL_SAMPLE_FILES=20
BACKUP_RETENTION_KEEP_ALL_DAYS=2
BACKUP_RETENTION_DAILY_DAYS=14
BACKUP_RETENTION_WEEKLY_WEEKS=8
BACKUP_RETENTION_MONTHLY_MONTHS=12
BACKUP_RETENTION_YEARLY_YEARS=2
BACKUP_RETENTION_MAX_MB=0

# Internal admin bridge (required for admin-management backup operations)
INTERNAL_ADMIN_ENABLED=true
INTERNAL_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_INTERNAL_TOKEN
INTERNAL_ADMIN_ALLOWED_IPS=127.0.0.1,::1
INTERNAL_ADMIN_REQUIRE_LOOPBACK=true
INTERNAL_ADMIN_RATE_LIMIT_PER_MINUTE=120
