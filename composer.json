{
    "name": "wayvio/wayvio",
    "type": "project",
    "description": "Public source release of the Wayvio platform, derived from LinkStack and adapted for the hosted Wayvio SaaS product",
    "keywords": ["link"],
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "awssat/laravel-visits": "^6.0",
        "cohensive/oembed": "^0.17",
        "doctrine/dbal": "^3.0",
        "geo-sot/laravel-env-editor": "^2.0",
        "guzzlehttp/guzzle": "^7.4",
        "jeroendesloovere/vcard": "^1.7",
        "laravel/framework": "^10.48.29",
        "laravel/socialite": "^5.26",
        "laravel/tinker": "^2.5",
        "livewire/livewire": "^2.12",
        "rappasoft/laravel-livewire-tables": "^2.15",
        "simplesoftwareio/simple-qrcode": "~4",
        "spatie/laravel-backup": "^8.1.5",
        "stripe/stripe-php": "*",
        "symfony/yaml": "^7.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.12",
        "fakerphp/faker": "^1.9.1",
        "laravel-lang/common": "^6.8",
        "laravel/breeze": "^1.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^7.11",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.8"
    },
    "autoload": {
        "files": [
            "app/Functions/functions.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "php artisan lang:update",
            "@php -r \"if(!is_dir('storage/app')) mkdir('storage/app', 0777, true); touch('storage/app/ISINSTALLED');\""
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
